<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Card — see docs/handoff/design-system.md "Components". Flat: no
         elevation anywhere, separation comes from the hairline border. -->
    <style name="Widget.StreetSense.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/color_border</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/color_card</item>
        <item name="rippleColor">@color/color_surface_sunken</item>
    </style>

    <!-- Compact card variant: same surface, tighter internal padding is
         applied by the layout using this style, not by the style itself. -->
    <style name="Widget.StreetSense.Card.Compact" />

    <!-- Inset well — used for chart backgrounds, stat cells, the segmented
         range control and the header battery pill. -->
    <style name="Widget.StreetSense.InsetWell" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">@dimen/radius_well</item>
        <item name="strokeWidth">0dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/color_surface_sunken</item>
    </style>

    <style name="Widget.StreetSense.Button.Primary" parent="Widget.Material3.Button">
        <item name="cornerRadius">@dimen/radius_stadium</item>
        <item name="backgroundTint">@color/color_primary</item>
        <item name="android:textColor">@color/color_primary_foreground</item>
        <item name="android:textAppearance">@style/TextAppearance.StreetSense.Body</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:minHeight">@dimen/min_touch_target</item>
        <item name="elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="rippleColor">@color/color_surface_sunken</item>
    </style>

    <style name="Widget.StreetSense.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">@dimen/radius_stadium</item>
        <item name="strokeColor">@color/color_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="backgroundTint">@color/color_card</item>
        <item name="android:textColor">@color/color_foreground</item>
        <item name="android:textAppearance">@style/TextAppearance.StreetSense.Body</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:minHeight">@dimen/min_touch_target</item>
        <item name="elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="rippleColor">@color/color_surface_sunken</item>
    </style>

    <!-- Circular back button on the top bar (44dp min target). -->
    <style name="Widget.StreetSense.Button.IconCircle" parent="Widget.Material3.Button.IconButton.Outlined">
        <item name="cornerRadius">@dimen/radius_stadium</item>
        <item name="strokeColor">@color/color_border</item>
        <item name="android:minWidth">@dimen/min_touch_target</item>
        <item name="android:minHeight">@dimen/min_touch_target</item>
        <item name="iconTint">@color/color_foreground</item>
    </style>
</resources>
