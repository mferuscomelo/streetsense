<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.StreetSense" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/color_primary</item>
        <item name="colorOnPrimary">@color/color_primary_foreground</item>
        <item name="colorSecondary">@color/color_accent</item>
        <item name="colorOnSecondary">@color/color_primary_foreground</item>
        <item name="colorSurface">@color/color_card</item>
        <item name="colorOnSurface">@color/color_foreground</item>
        <item name="colorSurfaceVariant">@color/color_secondary</item>
        <item name="colorOnSurfaceVariant">@color/color_muted_foreground</item>
        <item name="colorOutline">@color/color_border</item>
        <item name="colorError">@color/color_destructive</item>
        <item name="colorOnError">@color/color_primary_foreground</item>
        <item name="android:colorBackground">@color/color_background</item>
        <item name="colorOnBackground">@color/color_foreground</item>

        <item name="android:fontFamily">@font/dm_sans_family</item>
        <item name="fontFamily">@font/dm_sans_family</item>
        <item name="android:textViewStyle">@style/Widget.StreetSense.TextView</item>

        <item name="android:windowBackground">@color/color_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/color_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>

    <style name="Widget.StreetSense.TextView" parent="Widget.AppCompat.TextView">
        <item name="android:textColor">@color/color_foreground</item>
        <item name="android:textAppearance">@style/TextAppearance.StreetSense.Body</item>
    </style>
</resources>
