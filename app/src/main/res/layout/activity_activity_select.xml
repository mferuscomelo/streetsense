<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="96dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_gutter">

            <include
                android:id="@+id/topBar"
                layout="@layout/view_top_bar" />

            <TextView
                android:id="@+id/headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/activity_select_headline"
                android:textAppearance="@style/TextAppearance.StreetSense.ScreenTitle" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/activity_select_subtitle"
                android:textAppearance="@style/TextAppearance.StreetSense.BodySm" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_section"
                android:columnCount="2"
                android:rowCount="2">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/tileWalking"
                    style="@style/Widget.StreetSense.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="6dp"
                    android:minHeight="152dp"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <ImageView
                            android:id="@+id/iconWalking"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_footprints"
                            app:tint="@color/color_foreground" />

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/labelWalking"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/activity_walking_label"
                            android:textAppearance="@style/TextAppearance.StreetSense.Body"
                            android:textSize="16sp"
                            android:textFontWeight="500" />

                        <TextView
                            android:id="@+id/blurbWalking"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/activity_walking_blurb"
                            android:textAppearance="@style/TextAppearance.StreetSense.BodySm" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/tileJogging"
                    style="@style/Widget.StreetSense.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="6dp"
                    android:minHeight="152dp"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <ImageView
                            android:id="@+id/iconJogging"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_jogging"
                            app:tint="@color/color_foreground" />

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/labelJogging"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/activity_jogging_label"
                            android:textAppearance="@style/TextAppearance.StreetSense.Body"
                            android:textSize="16sp"
                            android:textFontWeight="500" />

                        <TextView
                            android:id="@+id/blurbJogging"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/activity_jogging_blurb"
                            android:textAppearance="@style/TextAppearance.StreetSense.BodySm" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/tileCycling"
                    style="@style/Widget.StreetSense.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="6dp"
                    android:minHeight="152dp"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <ImageView
                            android:id="@+id/iconCycling"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_bicycle"
                            app:tint="@color/color_foreground" />

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/labelCycling"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/activity_cycling_label"
                            android:textAppearance="@style/TextAppearance.StreetSense.Body"
                            android:textSize="16sp"
                            android:textFontWeight="500" />

                        <TextView
                            android:id="@+id/blurbCycling"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/activity_cycling_blurb"
                            android:textAppearance="@style/TextAppearance.StreetSense.BodySm" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/tileDriving"
                    style="@style/Widget.StreetSense.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="6dp"
                    android:minHeight="152dp"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <ImageView
                            android:id="@+id/iconDriving"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_car"
                            app:tint="@color/color_foreground" />

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/labelDriving"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/activity_driving_label"
                            android:textAppearance="@style/TextAppearance.StreetSense.Body"
                            android:textSize="16sp"
                            android:textFontWeight="500" />

                        <TextView
                            android:id="@+id/blurbDriving"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/activity_driving_blurb"
                            android:textAppearance="@style/TextAppearance.StreetSense.BodySm" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </GridLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_action_bar_fade"
        android:paddingHorizontal="@dimen/space_gutter"
        android:paddingTop="24dp"
        android:paddingBottom="@dimen/space_section">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/continueButton"
            style="@style/Widget.StreetSense.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:text="@string/action_continue"
            app:icon="@drawable/ic_arrow_right"
            app:iconGravity="textEnd"
            app:iconTint="@color/color_primary_foreground" />
    </FrameLayout>
</FrameLayout>
