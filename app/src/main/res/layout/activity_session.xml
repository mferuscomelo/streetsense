<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="100dp">

        <LinearLayout
            android:id="@+id/sessionColumn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_gutter">

            <include
                android:id="@+id/topBar"
                layout="@layout/view_top_bar" />

            <!-- Timer card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.StreetSense.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/card_padding">

                    <TextView
                        android:id="@+id/timerText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFeatureSettings="tnum"
                        android:text="00:00"
                        android:textAppearance="@style/TextAppearance.StreetSense.MetricXl" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/runStatusDot"
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:background="@drawable/bg_status_disc_inner" />

                        <TextView
                            android:id="@+id/runStatusLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:textAppearance="@style/TextAppearance.StreetSense.LabelCaps" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Status banner -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/bannerCard"
                style="@style/Widget.StreetSense.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/card_padding">

                    <ImageView
                        android:id="@+id/bannerIcon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="10dp" />

                    <ProgressBar
                        android:id="@+id/bannerSpinner"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="10dp"
                        android:visibility="gone" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/bannerTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.StreetSense.Body"
                            android:textFontWeight="500" />

                        <TextView
                            android:id="@+id/bannerDetail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAppearance="@style/TextAppearance.StreetSense.BodySm" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/bannerAction"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:minWidth="44dp"
                        android:minHeight="44dp"
                        android:gravity="center"
                        android:text="@string/action_retry"
                        android:textAppearance="@style/TextAppearance.StreetSense.Body"
                        android:textColor="@color/color_accent"
                        android:textFontWeight="500"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Readings -->
            <LinearLayout
                android:id="@+id/readingsColumn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <!-- Hero: PM2.5 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/heroCard"
                    style="@style/Widget.StreetSense.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/card_padding">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/map_metric_pm25"
                                android:textAppearance="@style/TextAppearance.StreetSense.LabelCaps" />

                            <TextView
                                android:id="@+id/heroBand"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.StreetSense.LabelCaps" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="bottom"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/heroValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFeatureSettings="tnum"
                                android:textAppearance="@style/TextAppearance.StreetSense.MetricXl" />

                            <TextView
                                android:id="@+id/heroUnit"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:layout_marginBottom="10dp"
                                android:textAppearance="@style/TextAppearance.StreetSense.Unit" />
                        </LinearLayout>

                        <io.streetsense.app.ui.SparklineView
                            android:id="@+id/heroSparkline"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/sparkline_hero"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Duo: Noise / VOC -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/noiseCard"
                        style="@style/Widget.StreetSense.Card"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:clickable="true"
                        android:focusable="true">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/card_padding">

                            <TextView
                                android:text="@string/map_metric_noise"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.StreetSense.LabelCaps" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="bottom"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/noiseValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFeatureSettings="tnum"
                                    android:textAppearance="@style/TextAppearance.StreetSense.MetricLg" />

                                <TextView
                                    android:id="@+id/noiseUnit"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="4dp"
                                    android:layout_marginBottom="6dp"
                                    android:textAppearance="@style/TextAppearance.StreetSense.Unit" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <io.streetsense.app.ui.SparklineView
                                    android:id="@+id/noiseSparkline"
                                    android:layout_width="0dp"
                                    android:layout_height="@dimen/sparkline_duo"
                                    android:layout_weight="1" />

                                <TextView
                                    android:id="@+id/noiseBand"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:textAppearance="@style/TextAppearance.StreetSense.LabelCaps" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/vocCard"
                        style="@style/Widget.StreetSense.Card"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:clickable="true"
                        android:focusable="true">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/card_padding">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="VOC"
                                android:textAppearance="@style/TextAppearance.StreetSense.LabelCaps" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="bottom"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/vocValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFeatureSettings="tnum"
                                    android:textAppearance="@style/TextAppearance.StreetSense.MetricLg" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="4dp"
                                    android:layout_marginBottom="6dp"
                                    android:text="index"
                                    android:textAppearance="@style/TextAppearance.StreetSense.Unit" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <io.streetsense.app.ui.SparklineView
                                    android:id="@+id/vocSparkline"
                                    android:layout_width="0dp"
                                    android:layout_height="@dimen/sparkline_duo"
                                    android:layout_weight="1" />

                                <TextView
                                    android:id="@+id/vocBand"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:textAppearance="@style/TextAppearance.StreetSense.LabelCaps" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- Secondary grid: PM1.0, PM4.0, PM10, Temperature, Humidity (spans) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/pm1Card"
                        layout="@layout/view_compact_metric_card"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp" />

                    <include
                        android:id="@+id/pm4Card"
                        layout="@layout/view_compact_metric_card"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/pm10Card"
                        layout="@layout/view_compact_metric_card"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp" />

                    <include
                        android:id="@+id/tempCard"
                        layout="@layout/view_compact_metric_card"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp" />
                </LinearLayout>

                <include
                    android:id="@+id/humidityCard"
                    layout="@layout/view_compact_metric_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" />
            </LinearLayout>

            <!-- Skeleton (before first sample) -->
            <LinearLayout
                android:id="@+id/readingsSkeleton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:visibility="gone">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:background="@drawable/bg_pill_well" />
            </LinearLayout>

            <!-- Route map -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/routeMapCard"
                    style="@style/Widget.StreetSense.InsetWell"
                    android:layout_width="match_parent"
                    android:layout_height="220dp">

                    <org.osmdroid.views.MapView
                        android:id="@+id/routeMap"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:id="@+id/mapMetricPills"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_pill_well"
                    android:orientation="horizontal"
                    android:padding="3dp">

                    <TextView
                        android:id="@+id/mapPillPm25"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="44dp"
                        android:minHeight="32dp"
                        android:gravity="center"
                        android:paddingHorizontal="12dp"
                        android:text="@string/map_metric_pm25"
                        android:textAppearance="@style/TextAppearance.StreetSense.BodySm" />

                    <TextView
                        android:id="@+id/mapPillPm10"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="44dp"
                        android:minHeight="32dp"
                        android:gravity="center"
                        android:paddingHorizontal="12dp"
                        android:text="@string/map_metric_pm10"
                        android:textAppearance="@style/TextAppearance.StreetSense.BodySm" />

                    <TextView
                        android:id="@+id/mapPillNoise"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="44dp"
                        android:minHeight="32dp"
                        android:gravity="center"
                        android:paddingHorizontal="12dp"
                        android:text="@string/map_metric_noise"
                        android:textAppearance="@style/TextAppearance.StreetSense.BodySm" />
                </LinearLayout>
            </FrameLayout>

            <!-- Set the map's card height via code (16:10) once width is known; placeholder here -->

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_action_bar_fade"
        android:paddingHorizontal="@dimen/space_gutter"
        android:paddingTop="24dp"
        android:paddingBottom="@dimen/space_section">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pauseResumeButton"
                style="@style/Widget.StreetSense.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="@string/action_pause"
                app:icon="@drawable/ic_pause"
                app:iconTint="@color/color_foreground" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/finishButton"
                style="@style/Widget.StreetSense.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="@string/action_finish"
                app:icon="@drawable/ic_square"
                app:iconTint="@color/color_primary_foreground" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
