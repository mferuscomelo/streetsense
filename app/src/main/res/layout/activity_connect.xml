<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="110dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_gutter">

            <include
                android:id="@+id/topBar"
                layout="@layout/view_top_bar" />

            <FrameLayout
                android:id="@+id/statusDiscContainer"
                android:layout_width="@dimen/status_disc_outer"
                android:layout_height="@dimen/status_disc_outer"
                android:layout_marginTop="@dimen/space_section"
                android:layout_gravity="center_horizontal">

                <View
                    android:id="@+id/statusDiscRing"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <FrameLayout
                    android:id="@+id/statusDiscInner"
                    android:layout_width="@dimen/status_disc_inner"
                    android:layout_height="@dimen/status_disc_inner"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_status_disc_inner">

                    <ImageView
                        android:id="@+id/statusIcon"
                        android:layout_width="@dimen/status_disc_icon"
                        android:layout_height="@dimen/status_disc_icon"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_bluetooth" />
                </FrameLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/statusTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.StreetSense.Title" />

            <TextView
                android:id="@+id/statusDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.StreetSense.BodySm" />

            <LinearLayout
                android:id="@+id/stepRail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_gravity="center_horizontal"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/stepScan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/step_scan"
                    android:textAppearance="@style/TextAppearance.StreetSense.LabelCaps" />

                <View
                    android:id="@+id/connector1"
                    android:layout_width="24dp"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="8dp"
                    android:background="@color/color_border" />

                <TextView
                    android:id="@+id/stepPair"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/step_pair"
                    android:textAppearance="@style/TextAppearance.StreetSense.LabelCaps" />

                <View
                    android:id="@+id/connector2"
                    android:layout_width="24dp"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="8dp"
                    android:background="@color/color_border" />

                <TextView
                    android:id="@+id/stepStream"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/step_stream"
                    android:textAppearance="@style/TextAppearance.StreetSense.LabelCaps" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/deviceCardContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_section">

                <!-- Skeleton: scanning / pairing -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/skeletonCard"
                    style="@style/Widget.StreetSense.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/card_padding">

                        <View
                            android:layout_width="120dp"
                            android:layout_height="16dp"
                            android:background="@drawable/bg_pill_well" />

                        <View
                            android:layout_width="90dp"
                            android:layout_height="12dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_pill_well" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="16dp"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_pill_well" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:layout_marginHorizontal="6dp"
                                android:background="@drawable/bg_pill_well" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:layout_marginStart="6dp"
                                android:background="@drawable/bg_pill_well" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Connected -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/connectedCard"
                    style="@style/Widget.StreetSense.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/card_padding">

                        <TextView
                            android:id="@+id/deviceName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.StreetSense.Body"
                            android:textSize="16sp"
                            android:textFontWeight="500" />

                        <TextView
                            android:id="@+id/deviceId"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFeatureSettings="tnum"
                            android:textAppearance="@style/TextAppearance.StreetSense.BodySm" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:orientation="horizontal">

                            <com.google.android.material.card.MaterialCardView
                                style="@style/Widget.StreetSense.InsetWell"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginEnd="6dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:padding="@dimen/card_padding_compact">

                                    <TextView
                                        android:text="@string/device_stat_battery_label"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textAppearance="@style/TextAppearance.StreetSense.LabelCaps" />

                                    <TextView
                                        android:id="@+id/deviceBattery"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:textAppearance="@style/TextAppearance.StreetSense.Body" />
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.card.MaterialCardView
                                style="@style/Widget.StreetSense.InsetWell"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="6dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:padding="@dimen/card_padding_compact">

                                    <TextView
                                        android:text="@string/device_stat_sensor_label"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textAppearance="@style/TextAppearance.StreetSense.LabelCaps" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:text="@string/device_stat_sensor_value"
                                        android:textAppearance="@style/TextAppearance.StreetSense.Body" />
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/warmingUpRow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:visibility="gone">

                            <ProgressBar
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:indeterminateTint="@color/color_muted_foreground" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="8dp"
                                android:text="@string/device_warming_up"
                                android:textAppearance="@style/TextAppearance.StreetSense.BodySm" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Error / what-to-check -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/errorCard"
                    style="@style/Widget.StreetSense.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/card_padding">

                        <TextView
                            android:id="@+id/errorCardTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/error_what_to_check"
                            android:textAppearance="@style/TextAppearance.StreetSense.Body"
                            android:textSize="16sp"
                            android:textFontWeight="500" />

                        <TextView
                            android:id="@+id/errorCardDetail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textAppearance="@style/TextAppearance.StreetSense.BodySm" />

                        <LinearLayout
                            android:id="@+id/errorHints"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="vertical" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Dropped mid-session -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/droppedCard"
                    style="@style/Widget.StreetSense.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/droppedText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/card_padding"
                        android:textAppearance="@style/TextAppearance.StreetSense.Body" />
                </com.google.android.material.card.MaterialCardView>
            </FrameLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_action_bar_fade"
        android:paddingHorizontal="@dimen/space_gutter"
        android:paddingTop="24dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/connectActionButton"
                style="@style/Widget.StreetSense.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/connectCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.StreetSense.BodySm" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
