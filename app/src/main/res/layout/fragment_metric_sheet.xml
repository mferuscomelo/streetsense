<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_top_rounded"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/panel_padding"
    android:paddingBottom="@dimen/space_section">

    <View
        android:layout_width="32dp"
        android:layout_height="4dp"
        android:layout_marginTop="12dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_pill_well" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/sheetSource"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.StreetSense.LabelCaps" />

            <TextView
                android:id="@+id/sheetTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextAppearance.StreetSense.Title" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/sheetValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:textAppearance="@style/TextAppearance.StreetSense.MetricLg" />

                <TextView
                    android:id="@+id/sheetUnit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="6dp"
                    android:textAppearance="@style/TextAppearance.StreetSense.Unit" />
            </LinearLayout>

            <TextView
                android:id="@+id/sheetBand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.StreetSense.LabelCaps" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rangeSelector"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_pill_well"
        android:orientation="horizontal"
        android:padding="3dp">

        <TextView
            android:id="@+id/range1Min"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:minWidth="44dp"
            android:paddingHorizontal="14dp"
            android:text="@string/range_1min"
            android:textAppearance="@style/TextAppearance.StreetSense.BodySm" />

        <TextView
            android:id="@+id/range5Min"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:minWidth="44dp"
            android:paddingHorizontal="14dp"
            android:text="@string/range_5min"
            android:textAppearance="@style/TextAppearance.StreetSense.BodySm" />

        <TextView
            android:id="@+id/rangeSession"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:minWidth="44dp"
            android:paddingHorizontal="14dp"
            android:text="@string/range_session"
            android:textAppearance="@style/TextAppearance.StreetSense.BodySm" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.StreetSense.InsetWell"
        android:layout_width="match_parent"
        android:layout_height="@dimen/metric_sheet_chart_height"
        android:layout_marginTop="16dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="@dimen/card_padding_compact">

            <io.streetsense.app.ui.AreaChartView
                android:id="@+id/chart"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <include
            android:id="@+id/statMin"
            layout="@layout/view_stat_cell"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp" />

        <include
            android:id="@+id/statAvg"
            layout="@layout/view_stat_cell"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp" />

        <include
            android:id="@+id/statMax"
            layout="@layout/view_stat_cell"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/sheetAbout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textAppearance="@style/TextAppearance.StreetSense.BodySm" />
</LinearLayout>
