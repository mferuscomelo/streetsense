<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.StreetSense.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/card_padding_compact">

        <TextView
            android:id="@+id/compactLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.StreetSense.LabelCaps" />

        <TextView
            android:id="@+id/compactValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:textAppearance="@style/TextAppearance.StreetSense.Metric" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <io.streetsense.app.ui.SparklineView
                android:id="@+id/compactSparkline"
                android:layout_width="0dp"
                android:layout_height="@dimen/sparkline_compact"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/compactBand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textAppearance="@style/TextAppearance.StreetSense.LabelCaps" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
