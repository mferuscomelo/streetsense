<?xml version="1.0" encoding="utf-8"?>
<!-- Display font — see docs/handoff/design-system.md. Variable font (wght
     axis); each weight below pins the axis on the same physical file. Used
     for screen titles and every numeric readout (tabular figures enabled
     per-view via android:fontFeatureSettings="tnum"). -->
<font-family xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        app:font="@font/space_grotesk"
        app:fontStyle="normal"
        app:fontWeight="400"
        app:fontVariationSettings="'wght' 400" />
    <font
        app:font="@font/space_grotesk"
        app:fontStyle="normal"
        app:fontWeight="500"
        app:fontVariationSettings="'wght' 500" />
    <font
        app:font="@font/space_grotesk"
        app:fontStyle="normal"
        app:fontWeight="600"
        app:fontVariationSettings="'wght' 600" />
</font-family>
